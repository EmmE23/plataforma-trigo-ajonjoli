# Plantilla de configuración. `npm run setup` crea .env.local automáticamente con una clave aleatoria.
# No escriba claves reales en este archivo: se sube al repositorio.

# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Ponga 1 solo si la aplicación está detrás de un proxy o servicio de hosting propio (usa la IP real del cliente).
TRUST_PROXY=0

# Carpeta de la base de datos local (opcional; por defecto data/pgdata).
# DATA_DIR=data/pgdata
